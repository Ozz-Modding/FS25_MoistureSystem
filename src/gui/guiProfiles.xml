<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUIProfiles>
    <Profile name="msTableHeader" extends="baseReference">
        <imageColor value="0 0 0 0" />
        <textFocusedColor value="$preset_fs25_colorMainHighlight" />
        <textHighlightedColor value="$preset_fs25_colorMainHighlight" />
        <textSize value="16px" />
        <textBold value="true" />
        <textUpperCase value="true" />
        <textColor value="$preset_colorWhite_50" />
        <textAlignment value="left" />
        <textDisabledColor value="$preset_colorDisabled" />
    </Profile>
    <Profile name="msTable" extends="emptyPanel" with="anchorStretchingYLeft pivotTopLeft" />
    <Profile name="msListItem" extends="baseReference" with="anchorTopStretchingX alternating">
        <height value="42px"/>
        <imageColor value="$preset_fs25_colorGrey" />
        <imageSelectedColor value="$preset_fs25_colorMainHighlight" />
        <alternateBackgroundColor value="$preset_fs25_colorGreyDark_50" />
    </Profile>
    <Profile name="msRowCellLeft" extends="baseReference" with="anchorStretchingYLeft">
        <textBold value="false" />
        <textSize value="15px" />
        <textAlignment value="left" />
        <textColor value="$preset_fs25_colorMainLight" />
        <textSelectedColor value="$preset_fs25_colorMainDark" />
        <textDisabledColor value="$preset_colorDisabled" />
    </Profile>
    <Profile name="msGroupsSliderBox" extends="fs25_listSliderBox" with="anchorTopLeft" />
    <Profile name="msDescriptiveText" extends="fs25_textGrey" with="anchorTopLeft">
        <textMaxNumLines value="4"/>
        <textVerticalAlignment value="top"/>
    </Profile>
    <Profile name="msDescriptiveTextSmall" extends="fs25_textGrey" with="anchorTopLeft">
        <textSize value="14px"/>
        <textMaxNumLines value="4"/>
        <textVerticalAlignment value="top"/>
    </Profile>
    <Profile name="msCalendarMonthHeader" extends="fs25_textDefault" with="anchorBottomLeft">
        <width value="102px"/>
        <margin value="0px 35px 0px 0px"/>
        <textSize value="18px"/>
        <textBold value="true"/>
        <textUpperCase value="true"/>
        <textAlignment value="center"/>
        <textVerticalAlignment value="bottom"/>
    </Profile>
    <Profile name="msCalendarValueCell" extends="fs25_textDefault" with="anchorMiddleCenter">
        <textSize value="18px"/>
        <size value="102px 105px"/>
        <margin value="0px 0px 0 0"/>
        <textBold value="true"/>
        <textAlignment value="center"/>
        <textVerticalAlignment value="middle"/>
        <textColor value="$preset_fs25_colorMainHighlight"/>
    </Profile>
    <Profile name="msCalendarLegendEnvironment" extends="fs25_textDefault">
        <size value="0px 30px"/>
        <margin value="8px 0 0 0"/>
        <textBold value="true"/>
        <textAutoWidth value="true"/>
        <textAlignment value="right"/>
        <textColor value="$preset_fs25_colorMainHighlight"/>
    </Profile>
    <Profile name="msCalendarDescription" extends="fs25_textGrey" with="anchorTopLeft">
        <textSize value="14px"/>
        <textMaxNumLines value="3"/>
        <textVerticalAlignment value="top"/>
    </Profile>

    <!-- Grades tab -->
    <Profile name="msGradesPanelLabel" extends="fs25_textDefault" with="anchorTopLeft">
        <size value="300px 22px"/>
        <textSize value="14px"/>
        <textBold value="true"/>
        <textUpperCase value="true"/>
        <textColor value="$preset_colorWhite_50"/>
        <textVerticalAlignment value="middle"/>
    </Profile>
    <Profile name="msGradesCropList" extends="msTable" with="anchorTopLeft pivotTopLeft">
        <absoluteSizeOffset value="0px 90px"/>
    </Profile>
    <Profile name="msGradesCropListItem" extends="msListItem">
        <height value="40px"/>
    </Profile>
    <Profile name="msGradesDetailPanel" extends="emptyPanel" with="anchorTopLeft">
    </Profile>
    <!-- One per chart (yield, quality). Children positioned relative to this,
         so the whole chart moves by changing only the container's position. -->
    <Profile name="msGradesChart" extends="emptyPanel" with="anchorTopLeft">
        <size value="1090px 152px"/>
    </Profile>
    <Profile name="msGradesCropTitle" extends="fs25_textDefault" with="anchorTopLeft">
        <textSize value="22px"/>
        <textBold value="true"/>
        <textUpperCase value="true"/>
        <textVerticalAlignment value="middle"/>
    </Profile>
    <Profile name="msGradesBarlabel" extends="fs25_textDefault" with="anchorTopLeft">
        <textSize value="15px"/>
        <textBold value="true"/>
        <textUpperCase value="true"/>
        <textColor value="$preset_colorWhite_50"/>
        <textAlignment value="right"/>
        <textVerticalAlignment value="middle"/>
    </Profile>
    <Profile name="msGradesBarlabelPct" extends="fs25_textDefault" with="anchorTopLeft">
        <textSize value="15px"/>
        <textBold value="true"/>
        <textAlignment value="left"/>
        <textColor value="$preset_fs25_colorMainHighlight"/>
        <textVerticalAlignment value="middle"/>
        <visible value="false"/>
    </Profile>
    <!-- Bar segment: 18px wide (1px gap each side), anchored top-left.
         Height is set dynamically in Lua proportional to yield/quality value.
         The bar area is 50px tall; full value = 50px, zero = 2px (min visible).
         No imageSliceId — inherits baseReference default which honours imageColor. -->
    <Profile name="msGradesBarSeg" extends="baseReference" with="anchorTopLeft">
        <size value="18px 100px"/>
        <imageColor value="0.3 0.7 0.3 1"/>
    </Profile>
    <Profile name="msGradesWitherMarker" extends="baseReference" with="anchorTopLeft">
        <size value="2px 106px"/>
        <imageColor value="0.9 0.3 0.1 1"/>
        <visible value="false"/>
    </Profile>
    <Profile name="msGradesMoistureMarker" extends="baseReference" with="anchorTopLeft">
        <size value="2px 106px"/>
        <imageColor value="1 1 1 0.8"/>
        <visible value="false"/>
    </Profile>
    <Profile name="msGradesLegendSwatch" extends="baseReference" with="anchorTopLeft">
        <size value="18px 18px"/>
        <imageColor value="0.3 0.7 0.3 1"/>
    </Profile>
    <Profile name="msGradesAxisLine" extends="baseReference" with="anchorTopLeft">
        <imageColor value="1 1 1 0.2"/>
    </Profile>
    <Profile name="msGradesAxisLabel" extends="fs25_textGrey" with="anchorTopLeft">
        <size value="56px 22px"/>
        <textSize value="13px"/>
        <textAlignment value="center"/>
        <textVerticalAlignment value="middle"/>
    </Profile>
    <!-- Mouse-hover cursor: vertical guide spanning both charts down to the axis
         line (top -48 to axis -362 = 314px tall), plus the highlighted moisture
         value shown on the axis label row directly beneath it. -->
    <Profile name="msGradesHoverLine" extends="baseReference" with="anchorTopLeft">
        <size value="1px 314px"/>
        <imageColor value="1 1 1 0.6"/>
        <visible value="false"/>
    </Profile>
    <Profile name="msGradesHoverAxisLabel" extends="fs25_textGrey" with="anchorTopLeft">
        <size value="72px 22px"/>
        <textSize value="13px"/>
        <textBold value="true"/>
        <textAlignment value="center"/>
        <textVerticalAlignment value="middle"/>
        <textColor value="$preset_fs25_colorMainHighlight"/>
        <visible value="false"/>
    </Profile>
    <Profile name="msGradesAxisTitle" extends="fs25_textGrey" with="anchorTopLeft">
        <textSize value="13px"/>
        <textBold value="true"/>
        <textUpperCase value="true"/>
        <textAlignment value="center"/>
        <textColor value="$preset_colorWhite_50"/>
        <textVerticalAlignment value="middle"/>
    </Profile>
    <Profile name="msGradesYAxisLabel" extends="fs25_textGrey" with="anchorTopLeft">
        <size value="56px 22px"/>
        <textSize value="12px"/>
        <textVerticalAlignment value="middle"/>
        <textColor value="$preset_colorWhite_50"/>
    </Profile>
    <Profile name="msGradesLegendText" extends="fs25_textGrey" with="anchorTopLeft">
        <size value="260px 22px"/>
        <textSize value="13px"/>
        <textVerticalAlignment value="middle"/>
    </Profile>
    <Profile name="msGradesStatLabel" extends="fs25_textDefault" with="anchorTopLeft">
        <textSize value="14px"/>
        <textVerticalAlignment value="middle"/>
    </Profile>

    <!-- Weather tab -->
    <Profile name="msWeatherSectionHeader" extends="fs25_textDefault" with="anchorTopLeft">
        <textSize value="18px"/>
        <textBold value="true"/>
        <textUpperCase value="true"/>
        <textColor value="$preset_colorWhite_50"/>
    </Profile>
    <Profile name="msWeatherPanelRow" extends="emptyPanel" with="anchorTopLeft">
        <flowLayoutGap value="20px"/>
    </Profile>
    <Profile name="msWeatherPanel" extends="emptyPanel" with="anchorTopLeft">
        <size value="450px 240px"/>
        <imageColor value="$preset_fs25_colorGrey"/>
        <padding value="15px"/>
    </Profile>
    <Profile name="msWeatherPanelTitle" extends="fs25_textDefault" with="anchorTopLeft">
        <size value="380px 36px"/>
        <textSize value="18px"/>
        <textBold value="true"/>
        <textUpperCase value="true"/>
        <textVerticalAlignment value="middle"/>
    </Profile>
    <!-- Summary row: icon (26px) + percentage + diff, 3 groups across 420px -->
    <Profile name="msWeatherGroupIcon" extends="baseReference" with="anchorTopLeft">
        <size value="26px 26px"/>
        <imageSdfWidth value="0.025"/>
    </Profile>
    <Profile name="msWeatherGroupPct" extends="fs25_textDefault" with="anchorTopLeft">
        <size value="50px 26px"/>
        <textSize value="15px"/>
        <textBold value="true"/>
        <textAlignment value="right"/>
        <textVerticalAlignment value="middle"/>
        <textColor value="$preset_fs25_colorMainHighlight"/>
    </Profile>
    <Profile name="msWeatherGroupDiff" extends="fs25_textGrey" with="anchorTopLeft">
        <size value="54px 24px"/>
        <textSize value="13px"/>
        <textAlignment value="left"/>
        <textVerticalAlignment value="middle"/>
    </Profile>
    <!-- Month / season rows: name label + icon (20px) + pct + diff -->
    <Profile name="msWeatherMonthIcon" extends="baseReference" with="anchorTopLeft">
        <size value="20px 20px"/>
        <imageSdfWidth value="0.025"/>
    </Profile>
    <Profile name="msWeatherMonthLabel" extends="fs25_textGrey" with="anchorTopLeft">
        <size value="72px 22px"/>
        <textSize value="14px"/>
        <textVerticalAlignment value="middle"/>
    </Profile>
    <Profile name="msWeatherMonthPct" extends="fs25_textDefault" with="anchorTopLeft">
        <size value="44px 22px"/>
        <textSize value="14px"/>
        <textBold value="true"/>
        <textAlignment value="right"/>
        <textVerticalAlignment value="middle"/>
        <textColor value="$preset_fs25_colorMainHighlight"/>
    </Profile>
    <Profile name="msWeatherMonthDiff" extends="fs25_textGrey" with="anchorTopLeft">
        <size value="40px 22px"/>
        <textSize value="12px"/>
        <textAlignment value="left"/>
        <textVerticalAlignment value="middle"/>
    </Profile>
    <Profile name="msWeatherNote" extends="fs25_textGrey" with="anchorTopLeft">
        <textSize value="13px"/>
        <textColor value="$preset_colorWhite_50"/>
        <textMaxNumLines value="2"/>
        <textVerticalAlignment value="top"/>
    </Profile>
    <Profile name="msWeatherNoData" extends="fs25_textGrey" with="anchorMiddleCenter">
        <textSize value="16px"/>
        <textAlignment value="center"/>
        <textVerticalAlignment value="middle"/>
    </Profile>
    <Profile name="msWeatherDisabledLabel" extends="fs25_textGrey" with="anchorTopLeft">
        <textSize value="16px"/>
        <textAlignment value="left"/>
        <textVerticalAlignment value="top"/>
    </Profile>

    <!-- Grain Drying tab -->
    <Profile name="msDryingListItem" extends="msListItem">
        <height value="42px"/>
    </Profile>
    <Profile name="msDryingCropsCell" extends="msRowCellLeft">
        <textMaxNumLines value="2"/>
        <textVerticalAlignment value="middle"/>
    </Profile>

    <!-- Irrigation tab -->
    <!-- The selector base is fs25_subCategorySelector: a real MultiTextOption
         profile that takes an explicit position/size, unlike the settings-page
         one which expects to sit in a full-width settings row. -->
    <Profile name="msIrrMultiOption" extends="fs25_subCategorySelector" with="anchorTopLeft" />
    <Profile name="msIrrSelectorLabel" extends="fs25_textGrey" with="anchorTopLeft">
        <size value="110px 26px"/>
        <textSize value="15px"/>
        <textVerticalAlignment value="middle"/>
    </Profile>
    <!-- Flat dark panel. Must extend baseReference, NOT emptyPanel: emptyPanel
         carries the base UI atlas filename with no slice, so a <Bitmap> using it
         falls back to the default UVs and paints the ENTIRE atlas: a block of
         icon soup where the panel should be. emptyPanel is safe only on a plain
         <GuiElement>, which draws nothing. -->
    <Profile name="msIrrPanel" extends="baseReference" with="anchorTopLeft">
        <imageColor value="0.045 0.045 0.045 0.7"/>
    </Profile>
    <Profile name="msIrrSectionHeader" extends="fs25_textDefault" with="anchorTopLeft">
        <size value="180px 26px"/>
        <textSize value="15px"/>
        <textBold value="true"/>
        <textUpperCase value="true"/>
        <textVerticalAlignment value="middle"/>
        <textColor value="$preset_colorWhite_50"/>
    </Profile>

    <!-- Day card. One per bookable day in the selected month; the whole card is
         the click target, and its background carries the selection colour. -->
    <Profile name="msIrrDayCard" extends="baseReference" with="anchorTopLeft">
        <size value="222px 112px"/>
        <imageColor value="0 0 0 0"/>
    </Profile>
    <Profile name="msIrrDayCardBg" extends="baseReference" with="anchorTopLeft">
        <size value="222px 112px"/>
        <imageColor value="0.05 0.055 0.05 0.85"/>
    </Profile>
    <!-- Selection marker. The card body stays dark in both states so the grey
         label and red note text keep their contrast; flooding the background
         with the highlight green made every line on the selected card
         unreadable. -->
    <Profile name="msIrrDayCardSel" extends="baseReference" with="anchorTopLeft">
        <size value="222px 4px"/>
        <imageColor value="$preset_fs25_colorMainHighlight"/>
    </Profile>
    <Profile name="msIrrDayLabel" extends="fs25_textGrey" with="anchorTopLeft">
        <size value="202px 18px"/>
        <textSize value="13px"/>
        <textUpperCase value="true"/>
        <textVerticalAlignment value="middle"/>
    </Profile>
    <Profile name="msIrrDayHours" extends="fs25_textDefault" with="anchorTopLeft">
        <size value="202px 28px"/>
        <textSize value="24px"/>
        <textBold value="true"/>
        <textVerticalAlignment value="middle"/>
    </Profile>
    <!-- Bar width is set in Lua, proportional to DAILY_CAPACITY_H. -->
    <Profile name="msIrrBarBg" extends="baseReference" with="anchorTopLeft">
        <size value="202px 5px"/>
        <imageColor value="1 1 1 0.12"/>
    </Profile>
    <Profile name="msIrrBarFill" extends="baseReference" with="anchorTopLeft">
        <size value="202px 5px"/>
        <imageColor value="$preset_fs25_colorMainHighlight"/>
    </Profile>
    <Profile name="msIrrDayBoost" extends="fs25_textDefault" with="anchorTopLeft">
        <size value="202px 18px"/>
        <textSize value="14px"/>
        <textVerticalAlignment value="middle"/>
        <textColor value="$preset_fs25_colorMainHighlight"/>
    </Profile>
    <!-- Sits where the boost/price lines do, replacing them on an unbookable day.
         The day still shows its real free-hours figure above. -->
    <Profile name="msIrrDayNote" extends="fs25_textGrey" with="anchorTopLeft">
        <size value="202px 38px"/>
        <textSize value="13px"/>
        <textMaxNumLines value="2"/>
        <textVerticalAlignment value="top"/>
        <textColor value="0.85 0.35 0.25 1"/>
    </Profile>
    <Profile name="msIrrDayPremium" extends="fs25_textGrey" with="anchorTopLeft">
        <size value="202px 16px"/>
        <textSize value="12px"/>
        <textVerticalAlignment value="middle"/>
    </Profile>

    <Profile name="msIrrQuoteLabel" extends="fs25_textGrey" with="anchorTopLeft">
        <size value="440px 24px"/>
        <textSize value="15px"/>
        <textVerticalAlignment value="middle"/>
    </Profile>
    <Profile name="msIrrQuoteValue" extends="fs25_textDefault" with="anchorTopLeft">
        <size value="440px 24px"/>
        <textSize value="15px"/>
        <textAlignment value="right"/>
        <textVerticalAlignment value="middle"/>
    </Profile>
    <Profile name="msIrrQuoteTotalLabel" extends="fs25_textDefault" with="anchorTopLeft">
        <size value="440px 26px"/>
        <textSize value="18px"/>
        <textBold value="true"/>
        <textUpperCase value="true"/>
        <textVerticalAlignment value="middle"/>
    </Profile>
    <Profile name="msIrrQuoteTotalValue" extends="fs25_textDefault" with="anchorTopLeft">
        <size value="440px 26px"/>
        <textSize value="18px"/>
        <textBold value="true"/>
        <textAlignment value="right"/>
        <textVerticalAlignment value="middle"/>
        <textColor value="$preset_fs25_colorMainHighlight"/>
    </Profile>
    <Profile name="msIrrCeilingNote" extends="fs25_textGrey" with="anchorTopLeft">
        <size value="400px 24px"/>
        <textSize value="13px"/>
        <textVerticalAlignment value="middle"/>
    </Profile>
    <!-- Long-form reason a day cannot be booked. Replaces the quote lines, and
         always names the cause: a clamped selector with no explanation reads as
         a bug. -->
    <Profile name="msIrrUnbookable" extends="fs25_textGrey" with="anchorTopLeft">
        <size value="884px 44px"/>
        <textSize value="15px"/>
        <textMaxNumLines value="2"/>
        <textVerticalAlignment value="top"/>
        <textColor value="0.85 0.35 0.25 1"/>
    </Profile>

    <Profile name="msIrrJobName" extends="fs25_textDefault" with="anchorTopLeft">
        <size value="180px 24px"/>
        <textSize value="15px"/>
        <textVerticalAlignment value="middle"/>
    </Profile>
    <Profile name="msIrrJobValue" extends="fs25_textGrey" with="anchorTopLeft">
        <size value="238px 24px"/>
        <textSize value="15px"/>
        <textAlignment value="right"/>
        <textVerticalAlignment value="middle"/>
    </Profile>
    <Profile name="msIrrJobsEmpty" extends="fs25_textGrey" with="anchorTopLeft">
        <size value="424px 24px"/>
        <textSize value="15px"/>
        <textVerticalAlignment value="middle"/>
    </Profile>
</GUIProfiles>
